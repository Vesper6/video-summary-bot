# =============================================
# Video Summary Bot - 环境变量示例
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# =============================================

# ---------- Anthropic / Claude ----------
# 必填：Anthropic API 密钥（标准 SDK）
ANTHROPIC_API_KEY=sk-ant-xxx

# 或（兼容 CC Switch 代理）鉴权 token，二选一
# ANTHROPIC_AUTH_TOKEN=sk-ant-xxx

# API 代理地址（默认 https://api.anthropic.com）
# ANTHROPIC_BASE_URL=https://api.your-proxy.com

# 使用的模型（默认 claude-sonnet-4-6）
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- 日志 ----------
# 日志级别：trace / debug / info / warn / error
RUST_LOG=info

# 日志格式：text / json
LOG_FORMAT=text
